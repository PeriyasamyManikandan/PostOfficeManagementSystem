
@model PostOfficeManagementSystem.Models.Postoffice

@{
    ViewBag.Title = "Delete Post Office Record";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">Confirm Delete</h3>
            <small>Please review the record before deleting it.</small>
        </div>

        <div class="card-body">
            <div class="alert alert-warning">
                <strong>Warning!</strong>
                Are you sure you want to permanently delete this record?
            </div>

            <table class="table table-bordered table-striped">
                <tr>
                    <th>Record ID</th>
                    <td>@Model.Id</td>
                </tr>
                <tr>
                    <th>First Name</th>
                    <td>@Model.Firstname</td>
                </tr>
                <tr>
                    <th>Last Name</th>
                    <td>@Model.Lastname</td>
                </tr>
                <tr>
                    <th>Address</th>
                    <td>@Model.Address</td>
                </tr>
                <tr>
                    <th>Scheme Name</th>
                    <td>@Model.Schemename</td>
                </tr>
                <tr>
                    <th>Balance</th>
                    <td>₹ @Model.Balance.ToString("N2")</td>
                </tr>
                <tr>
                    <th>No. of Years</th>
                    <td>@Model.No_of_years</td>
                </tr>
                <tr>
                    <th>Mobile</th>
                    <td>@Model.Mobile</td>
                </tr>
            </table>

            @using (Html.BeginForm(
                "DeleteConfirmed",
                "PostOffice",
                new { id = Model.Id },
                FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-danger"
                        onclick="return confirm('Are you sure you want to permanently delete this record?');">
                    Yes, Delete
                </button>

                @Html.ActionLink(
                    "Cancel",
                    "Index",
                    "PostOffice",
                    null,
                    new { @class = "btn btn-secondary" }
                )
            }
        </div>

        <div class="card-footer text-muted">
            <small>Post Office Management System</small>
        </div>
    </div>
</div>
