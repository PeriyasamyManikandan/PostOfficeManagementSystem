
@model IEnumerable<PostOfficeManagementSystem.Models.Postoffice>

@{
    ViewBag.Title = "Post Office Records";
}

<h2>Post Office Records</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<p>
    @Html.ActionLink("Create New Record", "Create",
        null, new { @class = "btn btn-primary" })
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Address</th>
            <th>Scheme Name</th>
            <th>Balance</th>
            <th>No. of Years</th>
            <th>Mobile</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Firstname</td>
                    <td>@item.Lastname</td>
                    <td>@item.Address</td>
                    <td>@item.Schemename</td>
                    <td>@item.Balance</td>
                    <td>@item.No_of_years</td>
                    <td>@item.Mobile</td>
                    <td>
                        @Html.ActionLink("Details", "Details",
                             new { id = item.Id },
                             new { @class = "btn btn-info btn-sm" })
                        @Html.ActionLink("Edit", "Edit",
                            new { id = item.Id },
                            new { @class = "btn btn-success btn-sm" })

                        @*@using (Html.BeginForm("Delete", "Delete",
                            new { id = item.Id }, FormMethod.Post))*@
                        @Html.ActionLink("Delete","Delete",
                            new { id = item.Id },
                            new { @class = "btn btn-danger btn-sm" })
   
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="9" class="text-center">
                    No Post Office records found.
                </td>
            </tr>
        }
    </tbody>
</table>